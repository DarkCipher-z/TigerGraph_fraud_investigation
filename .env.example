# ==========================================
# TigerGraph Agentic Fraud Investigation (HHGOA)
# Environment Configuration Template ($0.00 Free Tier)
# ==========================================

# 1. TigerGraph Credentials (TG Cloud Savanna / Community Docker)
TG_HOST=https://your-domain.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_tigergraph_password
TG_GRAPH=FraudGraph
TG_SECRET=your_tigergraph_secret_key
TG_API_TOKEN=your_tigergraph_api_token
TG_USE_MOCK=true

# 2. Supabase Credentials (Database with pgvector & RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Google AI Studio (text-embedding-004 & Gemini Flash)
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# 4. Groq API (Llama 3.3 70B Versatile)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Agent Orchestrator & Governance Thresholds
RISK_THRESHOLD_HIGH=75.0
RISK_THRESHOLD_LOW=35.0
CONFIDENCE_THRESHOLD_ACT=0.75
UNCERTAINTY_EVIDENCE_REQ=0.30
MAX_INVESTIGATION_ROUNDS=2
SAR_MIN_AMOUNT_THRESHOLD=5000.0

# 6. LLM Circuit Breaker Fallback Order
# Options: groq,gemini,deterministic
LLM_FALLBACK_CHAIN=groq,gemini,deterministic
